{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dextune.dev/hpcu/plan.schema.json",
  "title": "HPCU PlanIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "goal", "strategy", "entry_node_id", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "goal": {
      "type": "object",
      "required": ["id", "raw_instruction", "intent", "terminal_state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "raw_instruction": {"type": "string", "minLength": 1},
        "intent": {
          "enum": ["unknown", "navigate", "search", "select", "compare", "edit", "submit", "read", "monitor"]
        },
        "terminal_state": {"type": "string"},
        "explicit_url": {"type": "string"},
        "max_model_calls": {"type": "integer", "minimum": 0},
        "max_model_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "strategy": {
      "type": "object",
      "required": ["id", "goal_id", "execution_mode", "surface", "entry_kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "goal_id": {"type": "string", "minLength": 1},
        "execution_mode": {"enum": ["screen_strict", "local_semantic"]},
        "surface": {"type": "string", "minLength": 1},
        "entry_kind": {"enum": ["existing_screen", "url", "terminal_command", "workflow"]},
        "entry_value": {"type": "string"},
        "workflow_id": {"type": "string"}
      }
    },
    "entry_node_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "terminal"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"$ref": "action.schema.json"},
          "target_query": {"type": "object"},
          "evidence": {"$ref": "evidence.schema.json"},
          "success_next": {"type": ["string", "null"]},
          "failure_next": {"type": ["string", "null"]},
          "terminal": {"type": "boolean"},
          "allow_preexisting_success": {"type": "boolean"},
          "require_scene_change": {"type": "boolean"}
        }
      }
    }
  }
}
